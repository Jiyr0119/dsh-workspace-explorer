{
  "id": "dsh-workspace-explorer",
  "name": "工作区文件面板 (Workspace Explorer)",
  "version": "0.1.0",
  "description": "右侧弹出面板展示当前工作区目录文件树,点击或拖拽文件引用到聊天输入框发送给大模型",
  "kind": "dynamic-cordis-plugin",
  "platforms": {
    "host": "src/host.js",
    "client": "src/client.js"
  },
  "host": {
    "handlers": ["ws-tree.list"],
    "services": ["fs"]
  },
  "client": {
    "slots": [
      "sidebar.footer.action",
      "shell.overlay",
      "conversation.input.dock"
    ],
    "services": ["slots", "workspaces"]
  },
  "license": "MIT"
}
